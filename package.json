{
  "name": "ryz-clipsync",
  "version": "1.1.0",
  "description": "RYZ ClipSync — A premium clipboard manager with search, persistence, and system tray",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:win:arm": "electron-builder --win --arm64",
    "build:win:x86": "electron-builder --win --ia32",
    "build:win:all": "electron-builder --win --x64 --arm64 --ia32",
    "build:mac": "electron-builder --mac",
    "build:dir": "electron-builder --dir"
  },
  "keywords": [
    "clipboard",
    "manager",
    "electron",
    "ryz",
    "clipsync"
  ],
  "author": "R!Y4Z",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ryz.clipsync",
    "productName": "RYZ ClipSync",
    "files": [
      "**/*",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RYZ.ClipSync.Setup.${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "artifactName": "RYZ.ClipSync-${version}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}